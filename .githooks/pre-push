#!/bin/sh
set -eu

input="$(mktemp)"
trap 'rm -f "$input"' EXIT
cat > "$input"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/master" ] && [ "${ALLOW_MASTER_PUSH:-}" != "1" ]; then
    echo "Direct pushes to master are blocked. Push a work branch and merge a reviewed pull request." >&2
    exit 1
  fi
done < "$input"

"$(dirname "$0")/lfs-hook" pre-push "$@" < "$input"
