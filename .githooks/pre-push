#!/bin/sh
set -eu

input="$(mktemp)"
trap 'rm -f "$input"' EXIT
cat > "$input"

while read -r _local_ref _local_sha remote_ref _remote_sha; do
  if [ "$remote_ref" = "refs/heads/master" ] && [ "${ALLOW_MASTER_PUSH:-}" != "1" ]; then
    echo "Direct pushes to master are blocked. Push a work branch and merge a reviewed pull request." >&2
    exit 1
  fi
done < "$input"

if command -v git-lfs >/dev/null 2>&1; then
  git lfs pre-push "$@" < "$input"
elif git grep -q 'filter=lfs' -- .gitattributes ':(glob)**/.gitattributes' 2>/dev/null; then
  echo "Git LFS attributes are present but git-lfs is not installed." >&2
  exit 2
fi
