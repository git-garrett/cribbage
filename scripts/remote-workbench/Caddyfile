workbench.strongcribbage.com {
	import /etc/caddy/status-logging*.caddy
	header {
		-Server
		Cache-Control "no-store"
		X-Robots-Tag "noindex, nofollow, noarchive"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "same-origin"
		Strict-Transport-Security "max-age=31536000"
	}
	handle /login {
		reverse_proxy 127.0.0.1:18767 {
			header_up X-Access-IP {remote_host}
			header_up -Authorization
			header_down -Server
		}
	}
	handle {
		route {
			forward_auth 127.0.0.1:18767 {
				uri /verify
				header_up -Authorization
			}
			@write {
				not method GET HEAD
				not {
					method POST
					path /api/job-visibility
				}
			}
			respond @write "Method not allowed" 405
			reverse_proxy 127.0.0.1:18766 {
				header_up Host 127.0.0.1:8766
				header_up -Authorization
				header_up -Cookie
				header_down -Server
				transport http {
					dial_timeout 5s
					response_header_timeout 60s
				}
			}
		}
	}
	handle_errors {
		header {
			-Server
			Cache-Control "no-store"
			X-Robots-Tag "noindex, nofollow, noarchive"
		}
		respond "Temporarily unavailable. Please try again." {err.status_code}
	}
}
