{
  "scripts": {
    "build": "vite build",
    "cap:copy": "npm run build && cap copy",
    "cap:sync:ios": "npm run build && cap sync ios",
    "dev": "vite --host 0.0.0.0",
    "ios": "npm run cap:sync:ios && cap open ios",
    "compare:engines": "node scripts/compare-engines.cjs 300",
    "compare:engines:parallel": "node scripts/compare-engines-parallel.cjs 300",
    "benchmark:large-mixed": "node scripts/run-large-mixed-benchmark.cjs",
    "calibrate:pegging-table": "node --max-old-space-size=4096 scripts/calibrate-pegging-table.cjs 100 997 10",
    "simulate:ai-baseline": "node scripts/simulate-ai-baseline.cjs 1000 expert-peg-2.1",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  }
}
