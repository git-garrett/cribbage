{
  "version": "0.1.14",
  "scripts": {
    "build": "vite build",
    "cap:copy": "npm run build && cap copy",
    "cap:sync:ios": "npm run build && cap sync ios",
    "dev": "vite --host 0.0.0.0",
    "ios": "npm run cap:sync:ios && cap open ios",
    "compare:engines": "node scripts/compare-engines.cjs 300",
    "compare:engines:parallel": "node scripts/compare-engines-parallel.cjs 300",
    "benchmark:large-mixed": "node scripts/run-large-mixed-benchmark.cjs",
    "calibrate:pegging-table": "node --max-old-space-size=4096 scripts/calibrate-pegging-table.cjs 100 997 10",
    "benchmark:iterative-pegging-table": "node --max-old-space-size=8192 scripts/generate-iterative-pegging-table.cjs benchmark 96 8,10,12 3",
    "generate:iterative-pegging-table": "node --max-old-space-size=8192 scripts/generate-iterative-pegging-table.cjs generate benchmarks/pegging-table 12 3",
    "generate:iterative-pegging-table:2": "node --max-old-space-size=8192 scripts/generate-iterative-pegging-table.cjs generate benchmarks/pegging-table 12 3 0 0 none 0 2",
    "launch:background": "node scripts/launch-background.cjs",
    "launch:top-three-10k": "node scripts/launch-background.cjs top-three-10k -- /usr/local/bin/node scripts/run-top-three-10k-benchmark.cjs benchmarks/ai-smoke/top-three-10k-full-analytics 10000 25 10",
    "install:git-hooks": "git config core.hooksPath .githooks",
    "promote:artifact": "node scripts/promote-artifact.cjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "status:background": "node scripts/report-background-status.cjs",
    "simulate:ai-baseline": "node scripts/simulate-ai-baseline.cjs 1000 schell_table-peg_table-4.0",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  }
}
