{
  "version": "14.0.0",
  "scripts": {
    "build": "node --max-old-space-size=8192 node_modules/vite/bin/vite.js build",
    "build:server": "vite build --config vite.server.config.ts",
    "build:deploy": "npm run build && npm run build:server",
    "package:server": "COPYFILE_DISABLE=1 tar --no-xattrs -czf cribbage-server-${npm_package_version}.tgz dist server-dist package.json docs/nanode-rocky-server-setup.md",
    "cap:copy": "npm run build && cap copy",
    "cap:sync:ios": "npm run build && cap sync ios",
    "dev": "vite --host 0.0.0.0",
    "ios": "npm run cap:sync:ios && cap open ios",
    "calibrate:pegging-table": "node --max-old-space-size=4096 scripts/calibrate-pegging-table.cjs 100 997 10",
    "benchmark:iterative-pegging-table": "node --max-old-space-size=8192 scripts/generate-iterative-pegging-table.cjs benchmark 96 8,10,12 3",
    "generate:iterative-pegging-table": "node --max-old-space-size=8192 scripts/generate-iterative-pegging-table.cjs generate benchmarks/pegging-table 12 3",
    "generate:iterative-pegging-table:2": "node --max-old-space-size=8192 scripts/generate-iterative-pegging-table.cjs generate benchmarks/pegging-table 12 3 0 0 none 0 2",
    "launch:background": "node scripts/launch-background.cjs",
    "launch:top-three-10k": "node scripts/launch-background.cjs top-three-10k -- /usr/local/bin/node scripts/run-top-three-10k-benchmark.cjs benchmarks/ai-smoke/top-three-10k-full-analytics 10000 25 10",
    "export:ai-benchmark-summary": "node scripts/export-ai-benchmark-summary.cjs",
    "export:board-position-stats": "node scripts/export-board-position-stats.cjs",
    "build:rank-crib-discard-tables": "node --experimental-sqlite scripts/build-rank-crib-discard-tables.cjs",
    "build:tripolicy-crib-discard-table": "node scripts/build-tripolicy-crib-discard-table.cjs",
    "pack:tripolicy-crib-discard-table": "node scripts/pack-tripolicy-crib-discard-asset.cjs",
    "align:tripolicy-pegging-table": "node scripts/align-tripolicy-pegging-asset.cjs",
    "analyze:ai-run": "node --no-warnings scripts/analyze-ai-run.cjs",
    "import:ai-game-logs": "node scripts/import-ai-game-logs.cjs",
    "compact:ai-games": "node scripts/compact-existing-ai-games.cjs",
    "mark:ai-record": "node scripts/mark-ai-record.cjs",
    "install:git-hooks": "git config core.hooksPath .githooks",
    "promote:artifact": "node scripts/promote-artifact.cjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "status:background": "node scripts/report-background-status.cjs",
    "test": "vitest run",
    "typecheck": "node --max-old-space-size=8192 node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  }
}
