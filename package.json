{
  "version": "16.3.0",
  "scripts": {
    "build": "scripts/run-quiet.sh --show-warnings \"Client build\" scripts/build-client.sh",
    "build:deploy": "scripts/run-quiet.sh --show-warnings \"Deploy build\" /bin/sh -c 'npm run --silent build && cargo build --manifest-path rust/cribbage-api/Cargo.toml --release'",
    "package:server": "scripts/run-quiet.sh --show-warnings \"Server package\" /bin/sh -c 'scripts/package-rust-server.sh && node scripts/check-server-package.cjs'",
    "qa:predeploy": "scripts/predeploy_qa.sh",
    "cap:copy": "npm run build && cap copy",
    "cap:sync:ios": "npm run build && cap sync ios",
    "qa:client-cache": "node scripts/check-client-cache-contract.cjs",
    "dev": "vite --host 0.0.0.0",
    "ios": "npm run cap:sync:ios && cap open ios",
    "analyze:ai-run": "node --no-warnings scripts/analyze-ai-run.cjs",
    "report:paired-live": "node --no-warnings scripts/report-paired-live-benchmark.cjs",
    "report:model131": "node --no-warnings scripts/report-model131-full-analysis.cjs",
    "install:git-hooks": "git config core.hooksPath .githooks",
    "promote:artifact": "node scripts/promote-artifact.cjs",
    "prepare": "git config core.hooksPath .githooks || true",
    "test": "scripts/test-rust.sh",
    "test:quiet-wrapper": "scripts/test-run-quiet.sh",
    "test:web": "scripts/run-quiet.sh \"Web tests\" node_modules/.bin/vitest run",
    "typecheck": "scripts/run-quiet.sh \"TypeScript typecheck\" node --max-old-space-size=8192 node_modules/typescript/bin/tsc --noEmit"
  },
  "dependencies": {
    "@capacitor/core": "^7.4.4"
  },
  "devDependencies": {
    "@capacitor/cli": "^7.4.4",
    "@capacitor/ios": "^7.4.4",
    "@playwright/test": "^1.62.1",
    "typescript": "^5.9.3",
    "vite": "^7.2.7",
    "vitest": "^4.0.15"
  }
}
